{
  "name": "formfair",
  "version": "0.1.0",
  "description": "Static analysis of declared personal-name validation constraints in web-form markup",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run instrument && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "example": "npm run build && node scripts/generate-example.mjs",
    "test:delegated": "vitest run --config vitest.delegated.config.ts",
    "verify:package": "bash scripts/verify-packed-consumer.sh",
    "verify:solo": "npm run build && npm --prefix evaluation run test:solo",
    "instrument": "node scripts/write-instrument.mjs",
    "verify:snapshots": "node scripts/verify-snapshot-versions.mjs"
  },
  "dependencies": {
    "axe-core": "4.12.1",
    "parse5": "^7.2.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "jsdom": "^30.1.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  }
}
